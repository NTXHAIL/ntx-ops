# Postgres. On Vercel, connecting Neon from the Storage tab sets these.
# DATABASE_URL is the pooled connection. The app uses it at runtime.
# DATABASE_URL_UNPOOLED is the direct connection. Prisma Migrate uses it.
# Local Postgres can use the same address for both.
DATABASE_URL="postgresql://hailops:hailops@localhost:5432/hailops?schema=public"
DATABASE_URL_UNPOOLED="postgresql://hailops:hailops@localhost:5432/hailops?schema=public"

# Older Vercel Postgres names are also accepted when the current names are unset:
# POSTGRES_PRISMA_URL (pooled) and POSTGRES_URL_NON_POOLING (direct).
# DIRECT_URL is used only on a computer when DATABASE_URL_UNPOOLED is unset.

# Signs the login cookie. Required on Vercel. At least 32 random characters.
# The placeholder below is rejected in production.
# Generate one: https://generate-secret.vercel.app/32
AUTH_SECRET="replace-with-a-long-random-string"

# Photos. Connecting a Blob store in Vercel sets BLOB_READ_WRITE_TOKEN.
# Leave it unset on your computer to store photos in the local .data folder.
# BLOB_READ_WRITE_TOKEN=""

# Optional. VIN decode uses the public NHTSA vPIC DecodeVinValues API (no key).
# NHTSA_VPIC_URL="https://vpic.nhtsa.dot.gov/api/vehicles/DecodeVinValues"

# Staff notification when a storm landing page creates a lead.
# If SMTP_HOST is unset, Hail Ops logs the email to the console (dev fallback).
STAFF_NOTIFY_EMAIL="admin@ntxhail.local"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Hail Ops <ops@ntxhail.local>"

# Phase 2 stubs — do not send SMS or launch ads in this release.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
# META_AD_ACCOUNT_ID=""
# GOOGLE_ADS_CUSTOMER_ID=""
