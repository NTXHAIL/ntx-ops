# SQLite file is created under /prisma (path is relative to the prisma schema).
DATABASE_URL="file:./dev.db"

# Used to sign session cookies. Change this in any shared or production deploy.
AUTH_SECRET="replace-with-a-long-random-string"

# Optional. VIN decode uses the public NHTSA vPIC DecodeVinValues API (no key).
# NHTSA_VPIC_URL="https://vpic.nhtsa.dot.gov/api/vehicles/DecodeVinValues"

# Staff notification when a storm landing page creates a lead.
# If SMTP_HOST is unset, Hail Ops logs the email to the console (dev fallback).
STAFF_NOTIFY_EMAIL="admin@ntxhail.local"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Hail Ops <ops@ntxhail.local>"

# Phase 2 stubs — do not send SMS or launch ads in this release.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
# META_AD_ACCOUNT_ID=""
# GOOGLE_ADS_CUSTOMER_ID=""

