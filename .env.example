# PostgreSQL. The app uses DATABASE_URL at runtime.
# On Supabase this is the pooled connection (port 6543, pgbouncer).
# Add ?pgbouncer=true&connection_limit=1 so Prisma works on Vercel.
#
# DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# Local Postgres can use the same address for both variables:
DATABASE_URL="postgresql://hailops:hailops@localhost:5432/hailops?schema=public"

# Direct Postgres connection (port 5432). Prisma Migrate and the seed script use this.
# Do not use the pooler port here.
#
# DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://hailops:hailops@localhost:5432/hailops?schema=public"

# Signs the login cookie. Use a long random string on Vercel (32+ characters).
# The placeholder below is rejected in production.
AUTH_SECRET="replace-with-a-long-random-string"

# Supabase Storage. Required on Vercel. Leave both blank on your computer to
# store photos in a local folder instead of Supabase.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional. Defaults to estimate-photos. The bucket stays private.
# SUPABASE_STORAGE_BUCKET="estimate-photos"

# Optional. VIN decode uses the public NHTSA vPIC DecodeVinValues API (no key).
# NHTSA_VPIC_URL="https://vpic.nhtsa.dot.gov/api/vehicles/DecodeVinValues"

# Staff notification when a storm landing page creates a lead.
# If SMTP_HOST is unset, Hail Ops logs the email to the console (dev fallback).
STAFF_NOTIFY_EMAIL="admin@ntxhail.local"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Hail Ops <ops@ntxhail.local>"

# Phase 2 stubs — do not send SMS or launch ads in this release.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
# META_AD_ACCOUNT_ID=""
# GOOGLE_ADS_CUSTOMER_ID=""
